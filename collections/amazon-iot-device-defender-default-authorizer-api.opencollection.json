{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS IoT Accept Certificate Transfer Default Authorizer API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Default Authorizer",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon IoT Device Defender Describe Default Authorizer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://iot.{region}.amazonaws.com/default-authorizer",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ]
          },
          "docs": "<p>Describes the default authorizer.</p> <p>Requires permission to access the <a href=\"https://docs.aws.amazon.com/service-authorization/latest/reference/list_awsiot.html#awsiot-actions-as-permissions\">DescribeDefaultAuthorizer</a> action.</p>"
        },
        {
          "info": {
            "name": "Amazon IoT Device Defender Set Default Authorizer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://iot.{region}.amazonaws.com/default-authorizer",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "<p>Sets the default authorizer. This will be used if a websocket connection is made without specifying an authorizer.</p> <p>Requires permission to access the <a href=\"https://docs.aws.amazon.com/service-authorization/latest/reference/list_awsiot.html#awsiot-actions-as-permissions\">SetDefaultAuthorizer</a> action.</p>"
        },
        {
          "info": {
            "name": "Amazon IoT Device Defender Clear Default Authorizer",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://iot.{region}.amazonaws.com/default-authorizer",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ]
          },
          "docs": "<p>Clears the default authorizer.</p> <p>Requires permission to access the <a href=\"https://docs.aws.amazon.com/service-authorization/latest/reference/list_awsiot.html#awsiot-actions-as-permissions\">ClearDefaultAuthorizer</a> action.</p>"
        }
      ]
    }
  ],
  "bundled": true
}