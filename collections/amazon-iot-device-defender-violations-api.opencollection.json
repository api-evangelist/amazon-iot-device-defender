{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS IoT Accept Certificate Transfer Violations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Violations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon IoT Device Defender Put Verification State on Violation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://iot.{region}.amazonaws.com/violations/verification-state/:violationId",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "violationId",
                "value": "",
                "type": "path",
                "description": "The violation ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set a verification state and provide a description of that verification state on a violation (detect alarm)."
        }
      ]
    }
  ],
  "bundled": true
}