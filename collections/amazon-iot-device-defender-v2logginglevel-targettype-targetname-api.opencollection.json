      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "V2LoggingLevel#targetType&targetName",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon IoT Device Defender Delete V2 Logging Level",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://iot.{region}.amazonaws.com/v2LoggingLevel#targetType&targetName",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "targetType",
                "value": "",
                "type": "query",
                "description": "The type of resource for which you are configuring logging. Must be <code>THING_Group</code>."
              },
              {
                "name": "targetName",
                "value": "",
                "type": "query",
                "description": "The name of the resource for which you are configuring logging."
              }
            ]
          },
          "docs": "<p>Deletes a logging level.</p> <p>Requires permission to access the <a href=\"https://docs.aws.amazon.com/service-authorization/latest/reference/list_awsiot.html#awsiot-actions-as-permissions\">DeleteV2LoggingLevel</a> action.</p>"
        }
      ]
    }
  ],
  "bundled": true
