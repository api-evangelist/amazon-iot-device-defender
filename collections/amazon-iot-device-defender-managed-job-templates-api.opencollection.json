{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS IoT Accept Certificate Transfer Managed Job Templates API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Managed Job Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon IoT Device Defender Describe Managed Job Template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://iot.{region}.amazonaws.com/managed-job-templates/:templateName",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "templateName",
                "value": "",
                "type": "path",
                "description": "The unique name of a managed job template, which is required."
              },
              {
                "name": "templateVersion",
                "value": "",
                "type": "query",
                "description": "An optional parameter to specify version of a managed template. If not specified, the pre-defined default version is returned."
              }
            ]
          },
          "docs": "View details of a managed job template."
        },
        {
          "info": {
            "name": "Amazon IoT Device Defender List Managed Job Templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://iot.{region}.amazonaws.com/managed-job-templates",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "templateName",
                "value": "",
                "type": "query",
                "description": "An optional parameter for template name. If specified, only the versions of the managed job templates that have the specified template name will be returned."
              },
              {
                "name": "maxResults",
                "value": "",
                "type": "query",
                "description": "Maximum number of entries that can be returned."
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "The token to retrieve the next set of results."
              }
            ]
          },
          "docs": "Returns a list of managed job templates."
        }
      ]
    }
  ],
  "bundled": true
}